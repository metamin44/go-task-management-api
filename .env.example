# go-task-management-api — example configuration.
# Copy to .env for local development: .env is gitignored; never commit real secrets.
# Environment variables always take precedence over values in .env.

# --- Application ---
APP_ENV=development
HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s

# --- PostgreSQL (application connection) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=task_management
DB_USER=app_user
# Application database password. Replace change-me with a locally generated
# secret. It MUST be the same value as POSTGRES_PASSWORD below.
# Never display, print, or log this value.
DB_PASSWORD=change-me
# Local development ONLY: the local Docker container has no TLS, so disable is
# explicit here. Production MUST use verify-full. Required — there is no default.
DB_SSLMODE=disable

# --- Connection pool ---
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m

# --- Authentication ---
# HS256 signing secret for access tokens. REQUIRED, minimum 32 bytes.
# Generate a strong random value locally (e.g. `openssl rand -base64 48`)
# and replace change-me. Never display, print, log, or commit this value.
AUTH_ACCESS_SECRET=change-me
# Access token lifetime (default 15m). Must be a positive Go duration.
AUTH_ACCESS_TTL=15m
# Refresh token lifetime (default 720h = 30 days). Must be a positive Go duration.
AUTH_REFRESH_TTL=720h
# Per-IP rate limit for expensive auth operations (register/login/refresh/
# change-password): minimum average interval between requests per client IP.
# A fixed burst of 5 is allowed. In-process and per-instance — multi-replica
# deployments must ALSO enforce limits at the reverse proxy / shared gateway.
# Must be a positive Go duration. Default 1s.
AUTH_RATE_LIMIT_INTERVAL=1s
# Refresh-session cleanup tick (default 1h). A background worker drains expired/
# revoked rows older than the 30-day retention window in bounded 500-row batches.
# In-process and per-instance — multi-replica deployments should coordinate
# cleanup externally (e.g. a single scheduled runner). Positive Go duration.
AUTH_CLEANUP_INTERVAL=1h

# --- PostgreSQL Docker container only ---
# Used by the postgres:17-alpine container initialization (POSTGRES_* variables),
# not by the application. Replace change-me with the SAME locally generated
# secret as DB_PASSWORD above. Never display, print, or log this value.
POSTGRES_PASSWORD=change-me